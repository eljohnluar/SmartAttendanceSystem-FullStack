# Copy to backend/.env and fill in. Leave a value blank to run in demo mode.

# Supabase  (Project Settings > API). Use the service-role key: this script is a
# trusted server, and it must be able to write attendance rows past RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Fingerprint scanner ───────────────────────────────────
# The ZKTeco Live20R plugs into this computer over USB and keeps no prints of
# its own, so the ZKFinger SDK has to be installed on this machine and the
# scanner has to stay plugged in while students are arriving.
#   SCANNER_MODE = auto      use the USB scanner, fall back to typed scans
#                  usb        refuse to run without the scanner   <- use at school
#                  simulate   no hardware needed (development)
SCANNER_MODE=auto
# Which scanner to open when several are attached (0 is the first).
SCANNER_INDEX=0
# How strict a match must be, 1-100. Leave blank for the SDK default; raise it
# if a print is ever matched to the wrong student.
SCANNER_MATCH_THRESHOLD=
# Re-read the saved prints into the scanner this often, in seconds, so students
# enrolled elsewhere appear without a restart.
TEMPLATE_RESYNC_SECONDS=60
# Only set when the SDK is not installed system-wide, e.g.
# ZKFP_DLL_PATH=C:\Windows\System32\libzkfp.dll
ZKFP_DLL_PATH=

# ── Parent emails ─────────────────────────────────────────
# Provider is picked automatically from whichever key you fill in:
#   BREVO_API_KEY  -> Brevo   (~300/day free, no domain proof needed)  <- recommended
#   RESEND_API_KEY -> Resend  (~100/day free, needs a verified domain)
#   GMAIL_*        -> Gmail SMTP (~50/day on a free account)
# Force one with EMAIL_PROVIDER=brevo|resend|smtp|off; leave all blank to print emails here.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
RESEND_API_KEY=

# The address parents see in the "From" line.
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=School Attendance

# Gmail app password  →  myaccount.google.com > Security > 2-Step Verification > App passwords
# A 16-character app password, not the account password. Also what you paste into
# Supabase Studio > Authentication > Emails > SMTP Settings (host smtp.gmail.com, port 587).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_FROM_OVERRIDE=

# Scanner tuning. When a class starts and how much late grace it gets are no
# longer set here — each grade keeps its own rule, edited on the Attendance page
# and stored in grade_settings.
DUPLICATE_SCAN_MINUTES=45
HEARTBEAT_SECONDS=5
