; Copy this file to password.ini in the same folder, then set your own password
; on the line below. password.ini is git-ignored, so the key never lands in the
; repository, and the Inno Setup Compiler window reads it when you press F9.
;
; This protects the setup file, not your database. Anyone who has both this
; file and the setup can read the keys inside it.

[setup]
password=change-me-to-your-own
